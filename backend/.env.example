# ===================================================
# EzeeStayy Backend Configuration
# ===================================================

# DEMO_MODE: Controls 1-click demo role switching and demo auth bypass endpoints.
# Set to 'false' (default) in production to prevent privilege escalation.
# Set to 'true' for local development & demonstration.
DEMO_MODE=false

# MongoDB Connection (Auto-falls back to AsyncMongoMockClient in-memory if unreachable)
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=ezeestayy_db

# Security & Tokens
JWT_SECRET=ezeestayy_production_secret_key_relo_2026_983719482
ACCESS_TOKEN_EXPIRE_MINUTES=10080
